[Unit]
Description=@PROJECT_NAME@ service
# needs the Wayland session (WAYLAND_DISPLAY) for DPMS monitoring
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/@PROJECT_NAME@ @CMAKE_INSTALL_PREFIX@/share/@PROJECT_NAME@/config.json
Restart=on-failure
RestartSec=2
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
CPUAffinity=0

[Install]
WantedBy=graphical-session.target
